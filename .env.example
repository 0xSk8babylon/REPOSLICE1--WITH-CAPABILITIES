# Residential Energy Planner environment template
#
# Copy only the variables needed for a local task. Do not commit real secrets,
# production connection strings, Railway-resolved values, or API keys.

# Backend runtime
APP_ENV="local"
APP_NAME="Residential Energy Planner API"
API_VERSION="0.1.0"
DEBUG=true

# Auth development scaffolds. Keep false unless running local/test-only auth
# adapter tests. These must remain false for staging and production.
AUTH_ALLOW_SCAFFOLD_HEADERS=false
AUTH_ALLOW_FAKE_OIDC_TOKENS=false

# Local SQLite defaults. Leave DATABASE_URL blank to use SQLite at
# apps/api/data/residential_energy_planner.sqlite3.
DATA_DIR="apps/api/data"
DATABASE_FILE="residential_energy_planner.sqlite3"
DATABASE_URL=""

# Required when DATABASE_URL points at Postgres for local smoke, staging, or
# production. Keep both false unless a separate owner-approved plan says
# otherwise.
DATABASE_CREATE_ALL_ON_STARTUP=false
DATABASE_SEED_DEMO_DATA_ON_STARTUP=false

# Frontend local development. apps/web/.env.local may define these values.
VITE_API_BASE_URL="http://localhost:8000"
VITE_API_USER_ID="demo_user"
VITE_API_HOME_ACCESS="home_001"

# Ops-only session-report email. These are not product runtime variables.
RESEND_API_KEY="replace-with-resend-api-key"
SESSION_REPORT_EMAIL_FROM="Agent <agent@example.com>"
SESSION_REPORT_EMAIL_TO="matt@example.com"

# Future provider/auth/storage placeholders. Do not enable without an
# owner-approved auth/security/provider implementation plan.
# SECRET_KEY is intentionally not active. Reserve it only if a future framework
# integration requires one; prefer JWT_SECRET or SESSION_SECRET for explicit use.
# SECRET_KEY="replace-with-random-secret"
# JWT_SECRET="replace-with-random-secret"
# SESSION_SECRET="replace-with-random-secret"
# AUTH_PROVIDER_ISSUER_URL="https://issuer.example.com"
# AUTH_PROVIDER_CLIENT_ID="replace-with-client-id"
# AUTH_PROVIDER_CLIENT_SECRET="replace-with-client-secret"
# STORAGE_BUCKET_NAME="replace-with-bucket"
# STORAGE_ACCESS_KEY_ID="replace-with-access-key"
# STORAGE_SECRET_ACCESS_KEY="replace-with-secret-key"
